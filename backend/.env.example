# ==============================================================================
# OnboardHub Backend Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# Never commit your real .env file with production secrets to version control.
# ==============================================================================

# Groq Cloud API Key for AI Assistant (Get free key at: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
# Found under: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Secret Key (Required for server-side operations & storage signing)
# Found under: Supabase Dashboard -> Project Settings -> API -> Project API Keys (service_role secret)
SUPABASE_KEY=your_supabase_service_role_key_here

# Confidential password / key used by HR staff to access the HR Portal
HR_KEY=choose_a_secure_password_for_hr

# Allowed frontend origin URLs for CORS (comma-separated for multiple URLs)
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173
